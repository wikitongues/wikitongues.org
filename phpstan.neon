includes:
    - phpstan-baseline.neon
    - vendor/szepeviktor/phpstan-wordpress/extension.neon


parameters:
    level: 5
    scanFiles:
        # WP-CLI is not autoloaded during analysis; stub it so migration
        # commands under includes/cli/ are checked rather than baselined.
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
    paths:
        - wp-content/themes/blankslate-child
        - wp-content/plugins/wt-gallery
        - wp-content/plugins/wt-airtable-sync
        - wp-content/plugins/download-gateway
        - wp-content/plugins/typeahead/typeahead.php
        - tests
    excludePaths:
        - */vendor/*
        - */node_modules/*
        - wp-content/themes/blankslate-child/acf-json
        - wp-content/plugins/typeahead/build
