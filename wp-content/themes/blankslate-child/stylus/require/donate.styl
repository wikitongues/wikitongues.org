.wt-donate
	background $parchment
	color $black
	font 400 17px/1.6 'Graphik Web', Arial, sans-serif

	*
		box-sizing border-box

	[hidden]
		display none !important

	h1, h2, h3, p, ul, ol, fieldset
		margin 0

	ul, ol, fieldset
		padding 0

	ul, ol
		list-style none

	h1, h2, h3
		color inherit
		font 300 30px/1.2 'Schnyder Wide M Web', Georgia, serif

	h3
		font-size 24px

	:where(a, button, label, li, p, strong)
		font-size inherit
		line-height inherit

	a:not(.wt-donate__button)
		color $blue()

	a, button, summary, input
		focus-ring()

	&__wrap
		width 100%
		max-width $content-wide
		margin-inline auto
		padding-inline clamp(16px, 4vw, 32px)

		// Outside the Donate page these blocks sit between editorial text rows,
		// so they share the reading column instead of jogging out to $content-wide.
		body:not(.page-template-template-donate) &
			max-width $measure + 64px // the column plus the 32px side padding it has at this width

	&__hero, &__pair, &__feature
		display grid
		grid-template-columns repeat(2, minmax(0, 1fr))
		gap clamp(28px, 5vw, 64px)

	&__hero
		grid-template-columns minmax(0, 1fr) minmax(0, 440px)
		padding-block $space(7) $space(5)
		align-items start

	&__intro, &__gift, &__heading, &__story-copy, &__pair > div
		display grid
		gap $space(2)
		align-content start

	&__intro
		gap $space(3)
		padding-top 12px

		h1
			font-size clamp(32px, 5vw, 66px)
			overflow-wrap anywhere
			line-height 1
			text-transform uppercase

		> p:not([class])
			max-width 600px
			font-size clamp(19px, 2vw, 24px)
			line-height 1.3

	// inherit: eyebrows also sit on the dark monthly box
	& &__eyebrow
		eyebrow(inherit)

	// Large serif label above a section heading: "Gifts.", "Fellows.", "Questions."
	&__label
		font 300 clamp(40px, 6vw, 56px)/1 'Schnyder Wide L Web', 'Schnyder Wide M Web', Georgia, serif

	&__number
		typeface('')
		color $blue()
		font-size $type-label
		font-weight 600
		line-height 1.4
		letter-spacing .06em

	&__highlight
		background url('../img/donate/highlight.png') center / 100% 88% no-repeat
		padding-inline .08em
		-webkit-box-decoration-break clone
		box-decoration-break clone

	&__underline
		background url('../img/donate/underline.png') left bottom / 100% .42em no-repeat
		padding-bottom .12em

	&__trust
		display flex
		align-items center
		gap 20px
		font-size $type-small

		img
			display block
			object-fit contain

		li
			margin-block 4px

	&__jump
		display flex
		align-items flex-start
		gap 4px
		max-width 420px
		font-size 17px
		line-height 1.4

		// Size, rotation and offset as in the design mockup.
		&::after
			content ''
			flex 0 0 86px
			height 92px
			transform rotate(92deg) translate(18px, -6px)
			background url('../img/donate/arrow.png') center / contain no-repeat

	&__gift
		border 2px solid $black
		padding clamp(16px, 3vw, 28px)
		gap 20px

		form, .wt-donate__checkout-fallback
			display grid
			gap 18px

		fieldset
			border 0
			min-width 0
			display grid
			grid-template-columns repeat(2, minmax(0, 1fr))
			gap $space(1)

		legend
			padding 0
			margin-bottom $space(1)
			font-size $type-label

		label
			position relative

		input[type=radio]
			position absolute
			opacity 0
			width 1px
			height 1px

			+ span
				display grid
				place-items center
				min-height 48px
				padding 6px
				border 1px solid $black
				font-weight 600
				cursor pointer

			&:checked + span
				background $black
				color $parchment

			&:focus-visible + span
				outline 3px solid $blue()
				outline-offset 2px

		.wt-donate__amounts span
			font-size 20px

	&__custom
		display grid
		gap 6px

		input
			min-width 0
			width 100%
			padding 10px 12px
			border 1px solid $black
			background transparent
			color inherit
			font inherit

	&__legal
		font-size $type-label

	&__button
		display inline-flex
		align-items center
		justify-content center
		justify-self start
		min-height 52px
		padding 14px 28px
		border 1px solid $black
		border-radius 0
		background $black
		color $parchment
		font inherit
		font-weight 600
		text-align center
		text-decoration none
		cursor pointer

		&:hover
			background $blue()
			color $parchment

	&__gift
		font-size $type-body

		.wt-donate__button
			width 100%

	&__button--outline
		background transparent
		color $black

	&__grid
		display grid
		grid-template-columns repeat(3, minmax(0, 1fr))

	&__reach
		background $black
		color $parchment

		a, button
			focus-ring($parchment)

		ul
			padding-block $space(8)
			padding-inline clamp(16px, 4vw, 32px)
			margin-inline auto
			gap $space(4)

		li
			max-width 28ch

		strong
			display block
			font 300 clamp(42px, 6vw, 70px)/1.1 'Schnyder Wide M Web', Georgia, serif

	&__stat-prefix
		font-size .4em

	&__rule
		border-top 1px solid $black

	&__section
		display grid
		gap $space(5)
		padding-block clamp(52px, 8vw, 96px)

	&__heading
		max-width 760px

	&__programs
		grid-template-columns repeat(var(--columns, 3), minmax(0, 1fr))
		border-top 1px solid $black
		border-left 1px solid $black

		li
			display grid
			align-content start
			gap 12px
			padding clamp(16px, 3vw, 32px)
			border-right 1px solid $black
			border-bottom 1px solid $black

	&__story-art
		display grid
		place-items center
		min-height 185px
		padding $space(2)
		background $wash
		text-align center
		font 300 clamp(25px, 4vw, 52px)/1.15 'Schnyder Wide M Web', Georgia, serif

	&__story-art--photo
		display block
		width 100%
		height auto
		min-height 0
		aspect-ratio 16 / 9
		padding 0
		object-fit cover
		object-position 50% 30%

	&__feature
		align-items center

		.wt-donate__story-art
			min-height clamp(185px, 32vw, 420px)
			border 1px solid $black

		.wt-donate__story-art--photo
			min-height 0

		h3
			font-size 36px

		p:not([class])
			font-size 19px

	&__stories
		gap $space(3)

		article
			border 1px solid $black

		.wt-donate__story-art
			border-bottom 1px solid $black
			font-size clamp(24px, 3vw, 36px)

		.wt-donate__story-copy
			padding $space(3)

			p:not([class])
				font-size $type-body

	&__pair
		align-items stretch

		> div
			grid-template-rows auto auto auto 1fr
			align-content stretch
			gap 20px

			// Lines its button up with the monthly box's, as in the design.
			&:not(.wt-donate__monthly)
				padding-bottom clamp(22px, 4vw, 40px)

			p:not([class])
				font-size 19px

			.wt-donate__button
				align-self end

	&__monthly
		padding clamp(22px, 4vw, 40px)
		background $black
		color $parchment

		a, button, input
			focus-ring($parchment)

		.wt-donate__button
			background $parchment
			color $black

			&:hover
				background $yellow

	&__faq
		max-width 880px
		gap 0

		.wt-donate__heading
			gap $space(2)
			margin-bottom $space(4)

		details
			disclosure(28px)
			border-bottom 1.5px solid $black

			&:first-of-type
				border-top 1.5px solid $black

		summary
			padding-block 22px
			font-size 19px
			font-weight 400

		details p
			max-width 64ch
			margin 0 0 $space(3)

	&__close
		max-width $content-wide
		justify-items center
		text-align center
		gap 26px

		h2
			font-size clamp(32px, 5vw, 60px)
			overflow-wrap anywhere
			line-height 1.05
			text-transform uppercase

		p:not([class])
			max-width 576px
			font-size 19px

	&__actions
		display flex
		flex-wrap wrap
		justify-content center
		gap $space(2)

	[data-donate-share-status]:empty
		display none

@media (max-width: $tablet)
	.wt-donate__hero
		grid-template-columns minmax(0, 1fr) minmax(0, .9fr)
		gap $space(3)

@media (max-width: $mobile)
	.wt-donate
		&__hero, &__pair, &__feature, &__grid
			grid-template-columns minmax(0, 1fr)

		&__hero
			padding-top 28px

		&__reach ul
			padding-block $space(5)
