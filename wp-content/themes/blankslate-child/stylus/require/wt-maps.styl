// wt-maps: the locator maps (plan 3.2, docs/maps.md).
//
// The SVGs come from wt-maps/build; PHP adds .primary/.secondary to a page's
// places. One style, Light full (decided 2026-11-24): a parchment world with
// hillshade, the places filled with their coloured relief and outlined in the
// brand blue. Light focused, Dark full and Dark focused were retired that day;
// docs/plan-archive.md records them.
//
// Tokens live on the figure and on the shared <defs> (.wt-map-defs), because
// the hatch patterns are styled where they are defined, not where they are used.

.wt-map, .wt-map-defs {
	--paper: $parchment;
	--ink-2: #57534a;
	--sea: #e9e6ef; --land: #fbf7e8; --border: #c9c0d9;
	--primary: $blue(); --secondary: #9c8ad2; --dispute: #6b6478;
	--claim-line: $red; // the active contested areas' hatch (claims spec, lookdev F)
	--edge: #24107a; // deep blue: the globe's rim and view, continent dots and halos
	--dot: $yellow; // the globe's marker
	--globe-sea: #d6cdee; --globe-land: oklch(0.33 0.11 285);
}

.wt-map-defs { position: absolute; width: 0; height: 0; overflow: hidden; }

.wt-map { margin: 0; display: grid; gap: 8px; }
.wt-map__caption { font-family: 'Graphik Web', sans-serif; font-size: 13px; line-height: 1.4; color: var(--ink-2); }
// The disclaimer under a map with an active contested area (claims spec).
.wt-map__note { margin: 0; font-family: 'Graphik Web', sans-serif; font-size: 12px; line-height: 1.4; color: var(--ink-2); }
.wt-map__svg { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; max-width: 100%; border-radius: 3px; }
.wt-map .sea { fill: var(--sea); }
.wt-map .seashade { mix-blend-mode: hard-light; opacity: .65; }
.wt-map .land { fill: var(--land); stroke: var(--border); stroke-width: .6; stroke-linejoin: round; }
// The places: their coloured relief, outlined in the brand blue; others dashed.
.wt-map .hl { fill: var(--relief); stroke: var(--primary); stroke-width: .7; stroke-linejoin: round; }
.wt-map .hl.secondary { stroke-dasharray: 2.4 1.6; stroke-width: 1; }
// The hillshade 60% lighter and half-toned brown, so land outside the places
// reads as parchment. The places keep their depth: their relief (HYP_50M_SR)
// has its own shading.
.wt-map .shade { mix-blend-mode: hard-light; opacity: .4; filter: sepia(.5) saturate(.7); }
.wt-map .disputed { stroke: var(--dispute); stroke-width: .7; stroke-dasharray: 2 1.6; }
.wt-map .disputed.land { fill: var(--land); }
.wt-map .disputed.edge { fill: none; }
// Contested areas (claims spec, display): an active one, which a highlighted
// place claims, shows the coloured relief under the brand-red hatch, the same
// for primary and secondary places (the build's --claim pattern on .world). Any
// other is drawn as plain land with an ordinary border: nobody's.
.wt-map .hatch-claimed, .wt-map .hatch-primary, .wt-map .hatch-secondary { fill: var(--claim); }
.wt-map .disputed.plain { fill: var(--land); stroke: var(--border); stroke-width: .6; stroke-dasharray: none; stroke-linejoin: round; }
.wt-map .marker { fill: none; stroke-width: 2; }
.wt-map .marker.primary { stroke: var(--primary); }
.wt-map .marker.secondary { stroke: var(--secondary); }
.wt-map-defs .hc-line { stroke: var(--claim-line); stroke-width: 1.8; }
.wt-map .globe-halo { fill: var(--paper); }
.wt-map .globe-sea { fill: var(--globe-sea); }
.wt-map .globe-land { fill: var(--globe-land); }
.wt-map .globe-rim { fill: none; stroke: var(--edge); stroke-width: .9; }
.wt-map circle.globe-mark { fill: var(--dot); stroke: var(--edge); stroke-width: 1.2; }
.wt-map circle.globe-casing { fill: none; stroke: none; }
.wt-map .globe-view { fill: none; stroke: var(--dot); stroke-width: 2; stroke-linejoin: round; }
.wt-map path.globe-casing { fill: none; stroke: var(--edge); stroke-width: 4; stroke-linejoin: round; }
.wt-map .scale-bar { stroke: var(--ink-2); stroke-width: 2.4; stroke-linecap: round; }
.wt-map .scale-label { font-family: 'Graphik Web', sans-serif; font-weight: 600; font-size: 12px; fill: var(--ink-2); paint-order: stroke; stroke: var(--paper); stroke-width: 2.5px; stroke-linejoin: round; letter-spacing: .02em; }

/* Grouped maps (continents, plan 3.2 step 1c): each sub-region drawn as one shape.
   The borders inside a group are stroked in the group's own fill, so they vanish;
   the build draws the borders between groups and round them as lines (.grp-mesh),
   at the weight of a territory border, and a halo round island groups (.gh-fill,
   .gh-edge); small places are dots. */
.wt-map .grp .hl { stroke: var(--relief); stroke-dasharray: none; stroke-width: .6; }
.wt-map .grp-mesh { fill: none; stroke: var(--primary); stroke-width: .7; stroke-linejoin: round; stroke-linecap: round; }
// The land round a continent is drawn by sub-region too: no country borders
// (stroked in the land's own colour to close the seams), only region borders.
.wt-map .lands--regions .land { stroke: var(--land); }
.wt-map .grp-mesh--out { stroke: var(--border); stroke-width: .6; }
.wt-map .dot { fill: var(--edge); }
.wt-map .gh-fill { flood-color: var(--paper); flood-opacity: .55; }
.wt-map .gh-edge { flood-color: var(--edge); flood-opacity: .55; }
.wt-map .halo-hit { fill: none; stroke: none; } // A halo's hit area: never painted.
