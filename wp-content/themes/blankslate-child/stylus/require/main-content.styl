.main-content
	margin 3.2rem auto
	width 90%
	max-width $content
	clear both

	h1
		margin auto

	h1,h2,h4
		text--header($black)

	h3, strong
		text--strong($black) // Using both h3 and strong due to template return
		font-size 1.6rem
		margin 1.6rem 0
		display block

	p,
	label,
	article
		text--body($black)
		margin 0 auto
		padding 0.2rem 0 .6rem
		line-height 2.6rem

		&:first-of-type
			&::first-letter
				text--header($black)
				font-size 3.2rem

		a
			text--body($blue())
			anchor($blue(),2px)

	pre
		font-family monospace
		color inherit
		margin-bottom 0.8rem
		margin-left -1.6rem

	ul
		text--body($black)
		padding 0
		display inline-block

		&.link-group
			li
				list-style-type none
				padding 0

				a
					text--body($blue())
					border-left 2px solid $blue()
					padding 4px 8px
					float left

					&:hover
						text-decoration underline

		li
			margin-bottom 8px
			list-style-type initial
			padding 4px 8px
			float left
			clear both

			&:last-of-type
				margin-bottom 0

	// Editorial text rows (text-layout.php). Scoped so headings, lists and
	// tables authored in the WYSIWYG don't reach the other .main-content
	// surfaces (application page content, fellow about, document downloads),
	// which keep the generic rules above.
	&.main-content--text
		h2
			text--header($black)
			font-size $fontScale(6) // 3, matching gallery section headings
			margin 0 0 1.6rem

		em
			font-style italic

		a
			text--body($blue())
			anchor($blue(),2px)

		strong a
			font-weight inherit

		// Bulleted and numbered lists share one treatment. A list item's
		// lead-in stays inline, so it reads as part of the item rather than
		// as another subheading.
		ul, ol
			text--body($black)
			display block
			margin 0.8rem 0 1.6rem
			padding-left 2.4rem

			li
				float none
				clear none
				padding 4px 8px
				margin-bottom 8px
				line-height 2.6rem

				&:last-of-type
					margin-bottom 0

				strong
					display inline
					margin 0 0.4rem 0 0

		ul li
			list-style-type disc

		ol li
			list-style-type decimal

		// Tables scroll sideways on narrow screens instead of widening the
		// page.
		.table-scroll
			overflow-x auto
			margin 1.6rem 0

		table
			width 100%
			border-collapse collapse

			th, td
				text--body($black)
				padding 8px 12px
				border-bottom 1px solid $border-color
				text-align right
				white-space nowrap

				strong
					display inline
					margin 0

			thead th
				text--strong($black)
				border-bottom 2px solid $border-color

			tbody th
				text--strong($black)

			th:first-child
				text-align left

	&.wt_single-videos__embed
		max-width none
		width 100%
		border-radius 0

		h6
			max-width $content
			margin auto
			padding 0 0 32px 0

	>div,
	img
		margin-left auto
		margin-right auto
		max-width 100%

	&.has-image
		.image-container
			border-radius 4px
			background $black
			padding 8px
			float right
			width (2 / 3) * 100%
			margin 0 -32px 8px 16px

			p
				color $parchment
				padding .6rem 0 0

				&::first-letter
					text--body(inherit)
					font-size 1.6rem

		&:nth-of-type(2n - 1)
			margin-top 48px

			.image-container
				float left
				margin 0 16px 8px -32px