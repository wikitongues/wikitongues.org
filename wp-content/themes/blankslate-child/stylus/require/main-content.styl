.main-content
	margin 3.2rem auto
	width 90%
	max-width $content
	clear both

	h1
		margin auto

	h1,h2,h4
		text--header($black)

	h3, strong
		text--strong($black) // Using both h3 and strong due to template return
		font-size 1.6rem
		margin 1.6rem 0
		display block

	p,
	label,
	article
		text--body($black)
		margin 0 auto
		padding 0.2rem 0 .6rem
		line-height 2.6rem

		&:first-of-type
			&::first-letter
				text--header($black)
				font-size 3.2rem

		a
			text--body($blue())
			anchor($blue(),2px)

	pre
		font-family monospace
		color inherit
		margin-bottom 0.8rem
		margin-left -1.6rem

	ul
		text--body($black)
		padding 0
		display inline-block

		&.link-group
			li
				list-style-type none
				padding 0

				a
					text--body($blue())
					border-left 2px solid $blue()
					padding 4px 8px
					float left

					&:hover
						text-decoration underline

		li
			margin-bottom 8px
			list-style-type initial
			padding 4px 8px
			float left
			clear both

			&:last-of-type
				margin-bottom 0

	&.wt_single-videos__embed
		max-width none
		width 100%
		border-radius 0

		h6
			max-width $content
			margin auto
			padding 0 0 32px 0

	>div,
	img
		margin-left auto
		margin-right auto
		max-width 100%

// Editorial text rows (text-layout.php) and the fellow "About" block: a
// reading column of .wt_prose (prose.styl), which styles everything inside.
.wt_text-row
	width calc(100% - 3.2rem)
	max-width $measure
	margin 3.2rem auto
	clear both

	// Room above each new section. Padding, because a first child's margin
	// would collapse into the row's own margin.
	> h2:first-child
		padding-top 2.4rem
