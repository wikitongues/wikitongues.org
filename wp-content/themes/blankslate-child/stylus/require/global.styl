// Responsive Breakpoints
// ------------------
	$content = 1140px
	$content-wide = 1200px // editorial pages: the Language Rights report and donate
	$measure = ($content / 1.5) // reading column for running text (760px), shared with the blog
	$smallScreen = 1024px
	$tablet = 899px
	$shortScreen = 699px // for short and wide browsers
	$mobile = 768px // consider different number

// Colors
// ------------------
	$parchment = #fffcef
	$black = #101010
	$grey-50 = blend(rgba($black,.5),$parchment)
	$grey-33 = blend(rgba($black,.33),$parchment)
	$grey-25 = blend(rgba($black,.25),$parchment)
	$grey-65 = blend(rgba($black,.65),$parchment) // muted editorial text
	$red = #e52600
	$yellow = #ffff00

	$blue(tint = 100)
		// Returns a blended value for blue
		// Use $blue(22) for a 22% tint of blue
		// Values in use: 50, 30, 28, 25, 22, 15, 10
		base = #3814a5
		if tint < 100
			tint = tint / 100
			return blend(rgba(base, tint), $parchment)
		return base

	$border-color = $blue(22)

	// Editorial surfaces: a warm section background and divider, and a red that
	// passes AA as text on $parchment and $wash ($red is for fills and accents)
	$wash = #f3eee0
	$rule = #dcd5c3 // warm divider; $border-color is the blue one
	$red-text = #b54a35

// Typography Base
// ------------------
	html
		font-size 10px // make 16

	body
		max-width 1800px
		margin auto
		background $parchment

	// Header size scales down from $header value
	$header = 6rem
	$scaleDenominator = 12
	$fontScale(numerator)
		($header)*numerator/$scaleDenominator
	h1
		font-size $header
	h2
		font-size $fontScale(9) // 4.5
	h3
		font-size $fontScale(7) // 3.5
	h4
		font-size $fontScale(6) // 3
	h5
		font-size $fontScale(5) // 2.5
	h6
		font-size $fontScale(4) // 2

	p, a, time, button, strong, label, li, legend, th, td, em
		font-size 1.6rem
		line-height 1.5

	a
		text-decoration none

	$socialIcon = 2rem

// Editorial scale
// ------------------
	// px, not rem: the mobile rem shrink above would change editorial pages
	$type-label = 13px // eyebrows
	$type-small = 14px
	$type-body = 16px
	$type-lead = 18px
	$type-deck = 21px

	$space(n)
		// Spacing on an 8px grid: $space(3) is 24px
		n * 8px

	@media all and (max-width:$mobile)
		html
			font-size 51.398%

// Typography Mixins
// ------------------
	text--base(color)
		font-style normal
		font-stretch normal
		color color

	typeface(style)
		if style
			font-family 'Schnyder Wide M Web'
		else
			font-family 'Graphik Web', sans-serif

	text--header(color)
		text--base(color)
		typeface('display')
		font-weight 300

	text--body(color)
		text--base(color)
		typeface('')
		font-weight 400

	text--strong(color)
		// HTML Strong
		text--base(color)
		typeface('')
		font-weight 700
		line-height 1.3

	text--caption()
		background $yellow
		padding 8px 12px
		text--strong($black) // p

	sectionHeader--plain()
		// A gallery section heading that reads as a page heading rather than
		// the gallery's ruled section label. The gallery emits <strong>, which
		// the base scale sizes as body text, so restore the h4 size.
		text--header($black)
		font-size $fontScale(6)
		border-bottom none
		padding-bottom 0

	anchor(color, padding)
		text-decoration none
		color color
		padding padding (padding * 2)
		margin (padding * -1) (padding * -2)
		border-radius (padding * 2)

		&:hover
			background $blue(10)
			mix-blend-mode darken

// Editorial Mixins
// ------------------
	eyebrow(color = $black)
		// The small uppercase label above a heading. Links inside it keep its
		// size and colour instead of the base 1.6rem link style.
		text--base(color)
		typeface('')
		font-size $type-label
		font-weight 600
		line-height 1.4
		letter-spacing .06em
		text-transform uppercase

		a
			color inherit
			font-size inherit
			line-height inherit
			text-decoration none

	focus-ring(color = $blue())
		// Keyboard focus only. Pass $parchment on dark sections.
		&:focus-visible
			outline 3px solid color
			outline-offset 4px

	disclosure(toggle-size = 1.5em, spread = true)
		// Apply to <details>. Hides the native marker and puts a + after the
		// summary text that turns into a × when open. spread pushes the + to
		// the far edge; false keeps it beside the text.
		> summary
			display flex
			align-items center
			gap spread ? $space(2) : $space(1)
			cursor pointer
			list-style none

			&::-webkit-details-marker
				display none

			&::after
				content '+'
				flex none
				if spread
					margin-left auto
				font-size toggle-size
				line-height 1
				transition transform .2s

				@media (prefers-reduced-motion: reduce)
					transition none

		&[open] > summary::after
			transform rotate(45deg)

	signup-field()
		// The newsletter's email field (.wt_newsletter #mc_embed_signup), with
		// the input reset it relies on, so it stands alone in other forms
		border none
		-webkit-appearance none
		width 100%
		background $parchment
		font-family 'Graphik Web'
		color $blue()
		padding 1.6rem 1.6rem
		// px, not 1.6rem: the mobile rem shrink takes 1.6rem to ~13px, and iOS
		// zooms the page into any field under 16px when it gets focus
		font-size $type-body
		line-height 1.3
		text-transform none
		border-bottom 2px solid $blue()
		margin-right 8px
		border-radius 4px 4px 0 0
		transition background .1s ease-in-out

		&:focus,
		&:hover
			outline none
			background $blue(10)

	signup-button()
		// The newsletter's subscribe button
		button--secondary($blue(),$parchment)
		cursor pointer

// Button Mixins
// ------------------
	button--base(background, color)
		background background
		text--body(color)
		text-decoration none
		text-wrap nowrap
		border none

	button--primary(background, color)
		// HTML Section wrapping 1 or 2 Anchors
		button--base(background, color)
		border-radius 8px
		display flex
		overflow hidden
		justify-content space-between
		align-items stretch

		a
			padding 24px
			cursor pointer
			transition background-color .1s ease-in-out
			align-content center

			&:hover
				background $blue(15)

			&:last-of-type
				text--body($blue())

			&:first-of-type
				text--strong($blue())
				font-size 2rem


	button--secondary(background, color)
		// HTML Button
		button--base(background, color)
		padding 1.5rem 2rem
		line-height 1.3
		border-radius 4px
		cursor pointer
		display inline-block

		if background == $parchment
			transition background-color .1s ease-in-out

			&:hover
				background $blue(10)

// Miscelaneous
// ------------------
	.clear
		clear both

	.no-scroll
		overflow hidden

// Accordeon
// ------------------
@media all and (max-width:$mobile)
	.mobile-accordion-header
		cursor pointer

	.mobile-accordion-content
		overflow hidden
		max-height 0
		transition all .3s ease-in-out

	.mobile-accordion-content.active
		max-height 500px