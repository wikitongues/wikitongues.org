// Portrait beside the detail block. Shared typography is in person--meta.styl.
.wt_person--wide
	display flex

	&__img
		display inline-block
		width 95%
		max-width 300px
		height 300px
		background-position center center
		background-size cover
		background-repeat no-repeat
		border-radius 16px 0 16px 0

	&__meta
		display flex
		width 95%
		max-width 600px
		padding-left 2.4rem
		box-sizing border-box
		justify-content flex-end
		flex-direction column

@media all and (max-width:$mobile)
	.wt_person--wide
		display block
		width 100%

		&__img
			display block
			width 90%
			height 200px
			max-width none
			margin 0 auto 3rem
