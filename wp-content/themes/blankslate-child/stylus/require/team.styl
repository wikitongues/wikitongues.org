.page-template-template-about-staff,
.page-template-template-about-board
	.wrapper
		display grid
		grid-template-columns repeat(2, 1fr)
		align-items start
		gap 2.4rem 1.6rem
		max-width $content
		margin 0 auto 4.8rem

		> h4
			text--header($black)
			margin 0
			grid-column 1 / -1

@media all and (max-width:$mobile)
	.page-template-template-about-staff,
	.page-template-template-about-board
		.wrapper
			grid-template-columns 1fr

.custom-gallery.careers
	width $content
	margin 6.4rem auto

	h4
		text--header($black)
		border-bottom none
		margin-bottom 0

	.gallery-container
		.gallery-list
			.gallery-item
				a
					background-color transparent
					color $black
					anchor($blue(),4px)
					height initial
