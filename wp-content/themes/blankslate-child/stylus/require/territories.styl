.wt_meta--territories-single
	// Same width as the language sidebar (meta--languages-single.styl), so a
	// territory's map is the size of a language's.

	// Locator map (wt-maps, plan 3.2): under the title, above the lists.
	.wt-place-map
		margin 8px 0 24px

	.metadata
		width 100%

		&.related-territories
			.territories-list
				display flex
				flex-wrap wrap
				flex-direction row
				justify-content left

				.territory
					width 20%
					padding 8px
					box-sizing border-box

					a.territory-name
						text--strong($blue())
						padding 8px
						display inline-block

					.custom-gallery
						.gallery-container
							margin-bottom 0

		strong
			a
				text--strong($blue())
				display inline-block
				margin-bottom 4px

.wt_single-territories__content
	// Width from single-languages.styl: three quarters, beside the sidebar.

// Sub-region pages with a map: the sidebar on the left across two rows, the
// map (wider than the sidebar, so small islands read) above the galleries.
.wt_region-layout
	display grid
	grid-template-columns 1fr 3fr
	align-items start

	> .wt_meta--territories-single
		grid-column 1
		grid-row 1 / span 2
		width auto
		float none

	> .wt-place-map
		grid-column 2
		grid-row 1
		max-width 640px
		margin 0 6rem 4.8rem

	> .wt_single-territories__content
		grid-column 2
		grid-row 2
		width auto !important
		float none

.container
	width calc(100%/5 * 4)
	padding 0 6rem 6rem
	float left

	h1
		text--header($black)

	section
		ul.territories-list
			display grid
			grid-template-columns repeat(4, 1fr)
			gap 16px

			li
				width 100%

				.territory-name
					text--strong($blue())

				.custom-gallery
					.gallery-container
						margin 0

// Phone: stack the sidebar above the content, as language pages do, so the
// map gets the full width (the layout had no phone rules before the maps).
@media all and (max-width:$mobile)
	.wt_meta--territories-single
		float none
		width 100%
		padding 0 3rem
		box-sizing border-box
		margin-bottom 3rem

	.wt_single-territories__content
		float none !important
		width 100% !important
		padding 0 3rem !important

	// Region map between the title and the lists: the sidebar's own box
	// gives way (display contents) so its children can be ordered around it.
	.wt_region-layout
		display flex
		flex-direction column

		> .wt_meta--territories-single
			display contents

			> *
				order 3
				padding 0 3rem
				box-sizing border-box

			> h1
				order 1

		> .wt-place-map
			order 2
			margin 0 3rem 3rem

		> .wt_single-territories__content
			order 4
