// Name and role only. Sized a step below the section heading ($fontScale(6))
// so a column of these reads as content rather than a run of sub-headings.
.wt_person--list
	width 100%

	h4
		text--header($black)
		font-size $fontScale(5)
		margin 0

	strong
		text--strong($black)
		display block
		margin-top 0.4rem
