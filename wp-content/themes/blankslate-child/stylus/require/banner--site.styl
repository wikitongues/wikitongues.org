// Site banner (plan 1.4): the strip above the header, inside the sticky
// .wt_masthead (header.styl), which positions it.
.wt_site-banner
	box-sizing border-box
	width 100%
	padding 12px 15px
	background-color $blue()

	&__inner
		display flex
		flex-wrap wrap
		align-items center
		justify-content center
		gap 10px 20px
		max-width 1200px
		margin 0 auto

	&__message
		margin 0
		text--body($parchment)
		font-size 1.28rem !important
		font-weight 700 !important
		text-align center

	&__button
		button--secondary($parchment, $blue())
		display inline-flex
		align-items center
		gap .83rem
		text-decoration none
		white-space nowrap
