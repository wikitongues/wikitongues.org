// Site banner (plan 1.4): the strip above the header, inside the sticky
// .wt_masthead (header.styl), which positions it. One line on desktop
// (~52px); the button gets a style of its own so it never reads as nav.
.wt_site-banner
	position relative
	box-sizing border-box
	width 100%
	padding .8rem 5.2rem
	background-color $blue()

	&__inner
		display flex
		align-items center
		justify-content center
		gap 1.2rem 2.4rem
		max-width $content-wide
		margin 0 auto

	&__message
		margin 0
		text--body($parchment)
		font-size 1.6rem
		line-height 1.35

		strong
			font-weight 700

	&__button
		text--body($blue())
		display inline-flex
		flex none
		align-items center
		gap .8rem
		padding .7rem 1.6rem
		font-size 1.5rem
		font-weight 700
		line-height 1.3
		white-space nowrap
		text-decoration none
		background $yellow
		border-radius 999px
		transition background .15s

		&:hover,
		&:focus-visible
			background $parchment

		&:focus-visible
			outline 2px solid $parchment
			outline-offset 2px

	&__close
		position absolute
		top 50%
		right 1.2rem
		display flex
		align-items center
		justify-content center
		width 3.2rem
		height 3.2rem
		padding 0
		font-size 1.6rem
		color $parchment
		background none
		border none
		border-radius 50%
		transform translateY(-50%)
		cursor pointer
		opacity .8

		&:hover,
		&:focus-visible
			opacity 1
			background rgba($parchment, .15)

		&:focus-visible
			outline 2px solid $parchment

	// Phones: message and button stay side by side; the message wraps.
	@media (max-width $mobile)
		padding .8rem 4.4rem .8rem 1.6rem

		&__inner
			justify-content space-between

		&__message
			flex 1 1 auto
			min-width 0
			font-size 1.4rem

		&__button
			padding .6rem 1.2rem
			font-size 1.4rem

		&__close
			right .6rem

html.wt-site-banner-dismissed .wt_site-banner
	display none
