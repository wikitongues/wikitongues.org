$wpChrome = 32px
$primary = 56px
$headerFontSize = 14px

// The alert banner and header share one sticky masthead. Sticky (not fixed)
// keeps the masthead in the document flow, so content always starts below
// it, whatever it contains: subnav or not, alert banner or not, wrapped text.
// No page needs a margin-top to clear it.
//
// The theme removes core's admin-bar bump (template-helpers.php), so pad the
// body for the admin bar here. Core sets --wp-admin--admin-bar--height
// (32px, 46px under 782px) whenever the bar is shown.
body.admin-bar
	padding-top var(--wp-admin--admin-bar--height, $wpChrome)

.wt_masthead
	z-index 10
	position sticky
	top var(--wp-admin--admin-bar--height, 0px)

// Below 600px core makes the admin bar scroll away (position absolute), so
// the masthead sticks to the very top once the bar has gone.
@media screen and (max-width: 600px)
	.wt_masthead
		top 0

// The front page header is transparent and sits over the hero banner. It has
// no subnav, so it is exactly one primary bar tall.
body.home
	.wt_masthead
		margin-bottom -($primary)

.skip-link
	text--body($black)

	&:focus
		top 16px
		left 16px
		background $yellow
		color $black

.wt_header
	display flex
	flex-direction column
	align-items center
	width 100%
	box-sizing border-box
	background $parchment
	transition-property background
	transition-duration 0.3s
	transition-timing-function cubic-bezier(0.16, 1, 0.3, 1);

	a
		font-size $headerFontSize

	&.transparent-background
		background none
		transition-property background
		transition-duration 0.3s
		transition-timing-function cubic-bezier(0.16, 1, 0.3, 1);

		.wt_header__searchbar
			input[type="search"]
				background $parchment

	&__primary
		display flex
		align-items center
		width 100%
		padding 8px

	&__logo
		flex-grow initial

		a
			display inline-block
			padding 0
			float left

			&:hover
				background none

		&--light
			display none

			&.transparent-background
				display block !important

		&--dark
			display block

			&.transparent-background
				display none !important

		img
			height 40px
			width auto

	#typeahead_nav
		.typeahead-form
			input
				border none
				width 330px
				padding 11px

				&:active,
				&:focus
					width 400px
					background $parchment
					transition-property background, width
					transition-duration 0.6s
					transition-timing-function cubic-bezier(0.16, 1, 0.3, 1);

			.typeahead-list
				width 400px
				border-radius 8px
				outline 2px solid $blue()
				z-index 3

	@media all and (max-width:$smallScreen)
		#typeahead_nav.react-typeahead-container
			display none !important

	&__secondary
		border-top 1px solid $border-color
		width 100%

	&__nav
		margin-left auto

		#dark
			position fixed
			top 0
			left 0
			width 100%
			height 100vh
			background rgba(0, 0, 0, 0.25)
			opacity 0
			visibility hidden
			transition opacity 0.2s ease, visibility 0.2s ease
			z-index 1

			&.visible
				opacity 1
				visibility visible

		&--mobile
			display none

		&.transparent-background
			&>ul>li
				background $parchment
				border none !important

				&>a
					color $blue()

		.menu > li
			position relative
			margin-left 1.6rem
			button--secondary($parchment, $blue())
			border none
			border-radius 8px
			text-transform initial
			padding 0
			z-index 0

			// &.current_page_item,
			// &.current-menu-item,
			// &.current_page_parent
			// 	// pointer-events none

			// 	> a
			// 		font-weight bold
			// 		cursor default

			&>a // button--small is designed for a elements not li
				text-decoration none
				color inherit
				padding .95rem
				display inline-block

			&:hover
				cursor pointer
				z-index 2

			&.menu-item-has-children
				&:hover
					// &:not(.current_page_parent)
					> .sub-menu
						display block
						&.show
							display block

		.sub-menu
			display none
			position absolute
			top 40px
			left 0
			min-width 100%
			width max-content
			padding 8px 0
			text-align left
			box-shadow 0 0 100px rgba(0,0,0,.05)
			transition display 0.2s ease

			li
				display block
				margin 0
				background $parchment
				overflow hidden

				&:first-of-type
					padding-top 8px
					border-radius 8px 8px 0 0

				&:last-of-type
					padding-bottom 8px
					border-radius 0 0 8px 8px

				a
					color $blue()
					padding 1.25rem
					text-decoration none
					display inline-block
					width 100%

					&:hover
						background $blue(10)

		&--secondary
			z-index 2
			text-align center

			ul
				padding 8px 0

				li
					display inline-block
					margin 0 0 0 3rem

					&.current_page_item
						a
							font-weight bold

					a
						text--body($blue())
						font-size $headerFontSize
						text-decoration none
						padding 10px
						display inline-block

						&:hover
							cursor pointer

	&__mobile-buttons
			display none

@media all and (max-width:$smallScreen)
	.wt_header
		&__searchbar
			display none

@media all and (max-width:$tablet)
	.wt_header
		&__nav
			&--secondary
				white-space nowrap
				overflow-x scroll
				-ms-overflow-style none
				scrollbar-width none

				&::-webkit-scrollbar
					display none

				li
					&:first-of-type
						margin-left 0rem

					&:last-of-type
						margin-right 3rem

@media all and (max-width:$mobile)
	body
		&.logged-in
			.wt_header
				&__nav,
				&__secondary
					&--mobile
						top var(--wp-admin--admin-bar--height, 46px)

				&__mobile-buttons
					button
						&:last-of-type
							top 6.5rem

	.wt_header
		&__nav,
		&__secondary
			display	none

			&--mobile
				display block
				z-index 5
				position fixed
				top 0
				right -100%
				width 100%
				height 100vh
				overflow-y scroll
				box-sizing border-box
				padding 6rem
				background $parchment
				transition .2s right ease-in-out
				-ms-overflow-style none
				scrollbar-width none

				&::-webkit-scrollbar
					display none

				&.expand
					right 0

				&>ul
					&>li
						margin-bottom 3rem

						&>a
							text--strong($blue()) // a
							text-decoration none

						ul
							margin-top 1.5rem

							li
								margin-bottom 1.5rem

								a
									text--body($blue())
									text-decoration none

		&__mobile-buttons
			display block
			flex-grow 3
			text-align right

			button
				background none
				border none
				float right
				padding	11px 14px
				text--strong($black) // button

				&:hover
					cursor pointer

				&:focus
					outline none

				&:last-of-type
					display none
					z-index 7
					position fixed
					top 1rem
					right 1rem

		&.transparent-background
			.wt_header__mobile-buttons
					button:first-of-type
						text--strong($parchment) // button, issue